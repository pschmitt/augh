# POC scope: en-US only. Add locales here if/when other languages are needed.
locales(["en-US"])

app_package_name("dev.pschmitt.augh.debug")
tests_package_name("dev.pschmitt.augh.debug.test")
use_tests_in_classes(["dev.pschmitt.augh.ScreenshotTest"])

# Built remotely by `just screenshots-build`; screengrab only installs/drives them over adb.
app_apk_path("dist/app-debug.apk")
tests_apk_path("dist/app-debug-androidTest.apk")

output_directory("fastlane/metadata/android")

# "phone" by default; `just screenshots-tablet` overrides this to "sevenInch" for the Mi Pad 4
# (8" - Play's 7-inch bucket) so its captures land in a separate sevenInchScreenshots/ folder
# instead of overwriting the phone screenshots.
device_type(ENV.fetch("SCREENGRAB_DEVICE_TYPE", "phone"))

# Screengrab's `adb root`-dependent tricks (status bar clearing, demo mode) need a rooted
# device/emulator, which real (non-rooted) devices don't have. use_adb_root defaults to false,
# which is correct for those; flip it to true when capturing on a rooted emulator.
reinstall_app(true)
skip_open_summary(true)
